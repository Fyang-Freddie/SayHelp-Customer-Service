# Configure provider and MySQL credentials locally; never commit .env.
CHAT_BASE_URL=https://your-provider.example/v1
CHAT_MODEL=your-model
CHAT_API_KEY=
DATABASE_URL=
MODEL_CONTEXT_WINDOW=65536
# Startup queries the provider's /models context_window. If it is unavailable,
# set this only from the provider's official documented capacity.
# MODEL_PROVIDER_CONTEXT_WINDOW=1000000
MAX_OUTPUT_TOKENS=2000
MAX_USER_INPUT_TOKENS=2000
MAX_AGENT_STEPS=3
TOOL_RESULT_MAX_TOKENS=1200
RERANK_TOP_K=5
KNOWLEDGE_CONTEXT_TOKEN_BUDGET=4096
KNOWLEDGE_RESPONSE_TOKEN_RESERVE=512
HISTORY_TARGET_TURNS=32
HISTORY_STEADY_TOKENS=1024
SUMMARY_TOKEN_RESERVE=512
# Demo: change MODEL_CONTEXT_WINDOW to 18000; keep all other limits above.
